# Render/server variables only. NEVER prefix these with VITE_.
# memory storage for local development; production refuses to start without Supabase.
APP_ENV=development
ALLOWED_ORIGINS=https://attendance.varmalabs.tech,http://localhost:5173,http://127.0.0.1:5173
# 0 remembers the revocable app session until sign-out. CampX can still expire separately.
SESSION_TTL_SECONDS=0
CAMPX_MAX_CONCURRENCY=16
MAX_ACTIVE_OPERATIONS=8
# Enter these securely in environment settings, not in committed files:
# SUPABASE_URL=https://sknfnvupcgoarfzrfwvl.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# CAMPX_ENCRYPTION_KEY=  (a persistent Fernet key; see docs/backend.md)
# CAMPX_CLIENT_TOKEN=    (override the existing public client identifier if rotated)
FIREBASE_USAGE_ENABLED=false
FIREBASE_PROJECT_ID=attendance-90c12
# FIREBASE_SERVICE_ACCOUNT_JSON= (server-only credentials when usage is enabled)
# CAMPX_LOGIN_ID=        (development inspector only)
# CAMPX_PASSWORD=        (development inspector only)
# Short private per-student cache; 0 disables, maximum 300 seconds.
CACHE_TTL_SECONDS=60
# Enable push for a small opt-in pilot after migration/FCM setup; verify device delivery before broader rollout.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_BATCH_SIZE=2
NOTIFICATION_INTERVAL_SECONDS=900
# GOOGLE_APPLICATION_CREDENTIALS= (private server file path; alternate to inline JSON)
# FIREBASE_WEB_CONFIG= (public web config JSON; no service-account keys)
# FCM_VAPID_PUBLIC_KEY= (public Web Push certificate key from Firebase)
# CRON_SECRET= (generate a random value of at least 32 characters; server/scheduler only)
